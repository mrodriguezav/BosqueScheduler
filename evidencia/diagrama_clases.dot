digraph G {
  rankdir=LR; splines=polyline; nodesep=0.18; ranksep=0.55; concentrate=true; fontname="Helvetica";
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, arrowsize=0.8];

  Config [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td>«config»<br/><b>Configuracion</b></td></tr><hr/><tr><td align="left">+ franja, almuerzo: RangoHora<br align="left"/>+ duracionSesion: int<br align="left"/>+ cupoMaximo: int, tolerancia: double<br align="left"/>+ dedicacion, severidades: Map<br align="left"/></td></tr></table>>];
  Contexto [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td><b>Contexto</b></td></tr><hr/><tr><td align="left">+ cfg: Configuracion<br align="left"/>+ bloques: List&lt;Bloque&gt;, topeGrupo: int<br align="left"/>+ cursos, docentes, aulas: Map<br align="left"/></td></tr><hr/><tr><td align="left">+ capacidadRequerida(curso): int<br align="left"/>+ topeDocente(docente): int<br align="left"/>+ admiteDocente(docente, bloque): boolean<br align="left"/></td></tr></table>>];
  Curso [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td><b>Curso</b></td></tr><hr/><tr><td align="left">+ id, nombre, tipoAula: String<br align="left"/>+ inscritos, frecuencia: int<br align="left"/>+ habilitados: List&lt;String&gt;<br align="left"/></td></tr></table>>];
  Docente [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td><b>Docente</b></td></tr><hr/><tr><td align="left">+ id, dedicacion: String<br align="left"/>+ disponibilidad: Disponibilidad<br align="left"/></td></tr></table>>];
  Aula [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td><b>Aula</b></td></tr><hr/><tr><td align="left">+ id, tipo: String<br align="left"/>+ capacidad: int<br align="left"/></td></tr></table>>];
  Bloque [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td><b>Bloque</b></td></tr><hr/><tr><td align="left">+ id: String, dia: int<br align="left"/>+ inicio, fin: int<br align="left"/></td></tr></table>>];
  Sesion [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td><b>Sesion</b></td></tr><hr/><tr><td align="left">+ id: String<br align="left"/>+ cursoId, docenteId: String<br align="left"/>+ aulaId, bloqueId: String<br align="left"/></td></tr></table>>];
  Horario [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td><b>Horario</b></td></tr><hr/><tr><td align="left">- ctx: Contexto<br align="left"/>- sesiones: Map&lt;String, Sesion&gt;<br align="left"/>- ocDocente, ocAula: Map<br align="left"/>- carga, porCurso: Map<br align="left"/></td></tr><hr/><tr><td align="left">+ colocar(sesion), quitar(id)<br align="left"/>+ mover(id, bloqueId, aulaId)<br align="left"/>+ docenteEn(), aulaEn(), cargaDe()<br align="left"/>+ sesionesDeCurso(cursoId)<br align="left"/></td></tr></table>>];
  Violacion [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td><b>Violacion</b></td></tr><hr/><tr><td align="left">+ regla, severidad, motivo: String<br align="left"/></td></tr></table>>];
  Regla [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td>«abstracta»<br/><b><i>Regla</i></b></td></tr><hr/><tr><td align="left">+ codigo, severidad: String<br align="left"/>+ usaAula: boolean<br align="left"/></td></tr><hr/><tr><td align="left"><i>+ evaluar(candidata, horario): List&lt;Violacion&gt;</i><br align="left"/># violacion(motivo): List&lt;Violacion&gt;<br align="left"/></td></tr></table>>];
  Validador [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td><b>ValidadorRestricciones</b></td></tr><hr/><tr><td align="left">+ reglas: List&lt;Regla&gt;<br align="left"/></td></tr><hr/><tr><td align="left">+ evaluar(c, h): List&lt;Violacion&gt;<br align="left"/>+ esValida(c, h): boolean<br align="left"/>+ esValidaSinAula(c, h): boolean<br align="left"/>+ esValidaConAula(c, h): boolean<br align="left"/></td></tr></table>>];
  Generador [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td><b>GeneradorVoraz</b></td></tr><hr/><tr><td align="left">+ validador: ValidadorRestricciones<br align="left"/>+ ctx: Contexto, prefiltro: boolean<br align="left"/></td></tr><hr/><tr><td align="left">+ generar(h, orden)<br align="left"/>+ generarConRetroceso(h, orden)<br align="left"/>+ ubicarCurso(h, curso, pos, stats)<br align="left"/>+ colocarDia(h, curso, docente, dia, idx)<br align="left"/></td></tr></table>>];
  Auditor [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td>«utilidad»<br/><b>Auditor</b></td></tr><hr/><tr><td align="left">+ auditar(h): ResultadoAuditoria<br align="left"/></td></tr></table>>];
}
